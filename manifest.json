{
  "manifest_version": 3,
  "name": "Page Control",
  "version": "1.1",
  "description": "Adds control buttons to every page and AI-powered insights.",
  "permissions": ["tabs", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>", "https://api.openai.com/*"],

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Control"
  }
}
